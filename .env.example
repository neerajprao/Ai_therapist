# Copy to .env and edit. Never commit .env.

# local = everything runs on this machine. cloud = Groq for LLM and speech-to-text.
MODE=local

# --- LLM ---
# Lines starting with # use the MODE default. Uncomment only to override.
# ollama | groq. Default: ollama in local mode, groq in cloud mode.
# LLM_BACKEND=ollama
# Default: qwen2.5:7b-instruct (local), qwen/qwen3.8-27b (cloud). Must be a tag from `ollama list` or a Groq model ID.
# LLM_MODEL=qwen2.5:7b-instruct
OLLAMA_HOST=http://127.0.0.1:11434

# --- Speech-to-text ---
# local | groq. Default: local in local mode, groq in cloud mode.
# STT_BACKEND=local
# openai-whisper | faster-whisper (local only). openai-whisper measured faster on an M3 Pro; see eval/results/latency_local.json
LOCAL_STT_ENGINE=openai-whisper
WHISPER_MODEL=base
GROQ_STT_MODEL=whisper-large-v3-turbo

# --- Emotion ---
# torch | onnx. Default: torch (local), onnx (cloud). onnx runs without PyTorch.
# EMOTION_BACKEND=torch
EMOTION_MODEL_DIR=models/emotion_w2v2
EMOTION_ONNX_PATH=models/emotion_w2v2_int8.onnx
# Emotion2Vec is a 1.9 GB second model (torch backend only; fetch with
# `git lfs pull --include models/emotion2vec/model.pt`). On in local mode, off in cloud mode.
# If the weights are missing the app logs an error and uses Wav2Vec2 alone.
# ENABLE_EMOTION2VEC=true
# Weight of Wav2Vec2 in the ensemble; 1.0 means Wav2Vec2 alone. 0.4 was chosen
# on the validation split by eval/ensemble_eval.py.
# ENSEMBLE_W2V_WEIGHT=0.4
SILENCE_RMS=0.008

# --- Memory (RAG) ---
MEMORY_ENABLED=true
MEMORY_TOP_K=3
# Cosine distance; memories further than this are not injected. 0.7 was chosen by eval/memory_eval.py.
MEMORY_MAX_DISTANCE=0.7

# --- Coping-skills knowledge base (general wellbeing information) ---
# Notes in soulsync/knowledge/coping_notes.json (reviewed 2026-10-14). 0.75 chosen by eval/knowledge_eval.py.
KNOWLEDGE_ENABLED=true
KNOWLEDGE_MAX_DISTANCE=0.75

# --- Conversation ---
HISTORY_MAX_TURNS=8
# browser = Web Speech API, no server TTS. say = macOS `say` (local only).
TTS_BACKEND=browser

# --- Server ---
DATA_DIR=data
MAX_UPLOAD_MB=10
# Recordings each user may send per minute; 0 turns the limit off.
RATE_LIMIT_PER_MINUTE=12
LOG_LEVEL=INFO
# Required in cloud mode. Locally a key is generated in data/secret.key.
SECRET_KEY=
# Required when LLM_BACKEND or STT_BACKEND is groq.
GROQ_API_KEY=
