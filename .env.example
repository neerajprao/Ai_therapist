# Copy to .env and edit. Never commit .env.

# local = everything runs on this machine. cloud = Groq for LLM and speech-to-text.
MODE=local

# --- LLM ---
# ollama | groq. Defaults: ollama in local mode, groq in cloud mode.
LLM_BACKEND=ollama
# Must be a tag shown by `ollama list` (local) or a model in Groq's docs (cloud).
LLM_MODEL=qwen2.5:7b-instruct
OLLAMA_HOST=http://127.0.0.1:11434

# --- Speech-to-text ---
# local | groq
STT_BACKEND=local
# faster-whisper | openai-whisper (local only)
LOCAL_STT_ENGINE=faster-whisper
WHISPER_MODEL=base
GROQ_STT_MODEL=whisper-large-v3-turbo

# --- Emotion ---
# torch | onnx. onnx runs without PyTorch installed.
EMOTION_BACKEND=torch
EMOTION_MODEL_DIR=models/emotion_w2v2
EMOTION_ONNX_PATH=models/emotion_w2v2_int8.onnx
# Emotion2Vec is a 1.9 GB optional second model (torch backend only).
ENABLE_EMOTION2VEC=false
# Weight of Wav2Vec2 in the ensemble; 1.0 means Wav2Vec2 alone.
ENSEMBLE_W2V_WEIGHT=1.0
SILENCE_RMS=0.008

# --- Memory (RAG) ---
MEMORY_ENABLED=true
MEMORY_TOP_K=3
# Cosine distance; memories further than this are not injected.
MEMORY_MAX_DISTANCE=0.5

# --- Conversation ---
HISTORY_MAX_TURNS=8
# browser = Web Speech API, no server TTS. say = macOS `say` (local only).
TTS_BACKEND=browser

# --- Server ---
DATA_DIR=data
MAX_UPLOAD_MB=10
LOG_LEVEL=INFO
# Required in cloud mode. Locally a key is generated in data/secret.key.
SECRET_KEY=
# Required when LLM_BACKEND or STT_BACKEND is groq.
GROQ_API_KEY=
